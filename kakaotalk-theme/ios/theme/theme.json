{
  "name": "My KakaoTalk Theme",
  "author": "sujiniii",
  "version": "1.0.0",

  "_comment": "색상은 #RRGGBB 또는 #AARRGGBB. 안드로이드 palette.xml 과 같은 값을 쓰면 두 플랫폼 톤이 맞습니다.",

  "colors": {
    "background": "#FFFFFF",
    "backgroundElevated": "#F7F8FA",
    "backgroundSunken": "#EDEFF2",

    "text": "#16181D",
    "textSecondary": "#6B7280",
    "textDisabled": "#AAB0BA",

    "accent": "#FAE100",
    "accentPressed": "#E6CF00",
    "textOnAccent": "#16181D",

    "divider": "#1A000000",
    "scrim": "#66000000",

    "navigationBarBackground": "#FFFFFF",
    "navigationBarTitle": "#16181D",
    "tabBarBackground": "#FFFFFF",
    "tabBarItemNormal": "#6B7280",
    "tabBarItemSelected": "#16181D",

    "chatRoomBackground": "#EDEFF2",
    "bubbleMeBackground": "#FAE100",
    "bubbleMeText": "#16181D",
    "bubbleYouBackground": "#FFFFFF",
    "bubbleYouText": "#16181D",
    "chatTimeText": "#AAB0BA",
    "chatUnreadCountText": "#E6CF00",

    "inputBarBackground": "#FFFFFF",
    "inputText": "#16181D",
    "inputPlaceholder": "#AAB0BA",

    "badgeBackground": "#FF3B30",
    "badgeText": "#FFFFFF"
  },

  "images": {
    "_comment": "images/ 폴더에 있는 파일명을 씁니다. 안 쓰는 항목은 지우면 기본 이미지가 나옵니다.",
    "mainBackground": "main_bg@3x.png",
    "chatRoomBackground": "chatroom_bg@3x.png",
    "bubbleMe": "bubble_me@3x.png",
    "bubbleYou": "bubble_you@3x.png",
    "preview": "preview@3x.png"
  },

  "bubbleInsets": {
    "_comment": "말풍선 이미지에서 늘어나지 않아야 할 가장자리 두께(pt). 안드로이드 9-patch 에 해당.",
    "me":  { "top": 12, "left": 20, "bottom": 12, "right": 12 },
    "you": { "top": 12, "left": 12, "bottom": 12, "right": 20 }
  }
}
