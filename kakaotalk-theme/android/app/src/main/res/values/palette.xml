<?xml version="1.0" encoding="utf-8"?>
<!--
  팔레트 = 이 테마의 유일한 "진짜" 색 정의.
  colors.xml 의 thm_* 는 전부 여기를 참조하므로, 톤을 바꾸려면 이 파일만 고치면 된다.
  이미지가 정해지면 배경 이미지에서 색을 뽑아 아래 값만 교체할 것.
-->
<resources>
    <!-- 배경 계열: 뒤로 갈수록 앞에 얹히는 면 -->
    <color name="palette_bg">#FFFFFFFF</color>
    <color name="palette_bg_elevated">#FFF7F8FA</color>
    <color name="palette_bg_sunken">#FFEDEFF2</color>

    <!-- 텍스트 계열 -->
    <color name="palette_text">#FF16181D</color>
    <color name="palette_text_secondary">#FF6B7280</color>
    <color name="palette_text_disabled">#FFAAB0BA</color>
    <color name="palette_text_on_accent">#FF16181D</color>

    <!-- 포인트 컬러 -->
    <color name="palette_accent">#FFFAE100</color>
    <color name="palette_accent_pressed">#FFE6CF00</color>

    <!-- 선/구분자 -->
    <color name="palette_divider">#1A000000</color>
    <color name="palette_scrim">#66000000</color>

    <!-- 말풍선 -->
    <color name="palette_bubble_me">#FFFAE100</color>
    <color name="palette_bubble_you">#FFFFFFFF</color>
    <color name="palette_bubble_me_text">#FF16181D</color>
    <color name="palette_bubble_you_text">#FF16181D</color>

    <!-- 상태 -->
    <color name="palette_badge">#FFFF3B30</color>
    <color name="palette_badge_text">#FFFFFFFF</color>

    <!-- 완전 투명. 배경 이미지를 그대로 보여주고 싶은 자리에 쓴다. -->
    <color name="palette_transparent">#00000000</color>
</resources>
